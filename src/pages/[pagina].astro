---
// Gewone pagina's op een adres zonder .html: /webdesign toont webdesign.html uit de hoofdmap.
// De inhoud is bij het bouwen in de server ingebouwd. Pagina's aanpassen doe je dus gewoon in de
// .html-bestanden in de hoofdmap (en daarna publiceren). De Engelse versie staat op /en/webdesign.
import { paginaHtml, siteOrigin, htmlResponse, nietGevonden } from "../paginas";

export const prerender = false;

const naam = Astro.params.pagina as string;
if (naam === "index") return Astro.redirect(`/${Astro.url.search}`, 301);
const html = paginaHtml(naam, "nl", siteOrigin(Astro.request, Astro.url));
if (!html) return nietGevonden();
return htmlResponse(html);
---
