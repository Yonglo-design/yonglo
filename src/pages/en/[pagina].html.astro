---
// /en/webdesign.html → blijvend door naar /en/webdesign (zoekopdracht en anker blijven behouden).
import { PAGINAS_EN, nietGevonden } from "../../paginas";

const pagina = Astro.params.pagina as string;
if (pagina === "index") return Astro.redirect(`/en${Astro.url.search}`, 301);
if (!PAGINAS_EN.includes(pagina) || pagina === "404") return nietGevonden("en");
return Astro.redirect(`/en/${pagina}${Astro.url.search}`, 301);
---
