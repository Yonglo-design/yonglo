---
// Projectpagina op /project/<naam> — hetzelfde adres als op de oude yonglo.com.
// Wix bouwt deze pagina op de server op met het project uit de Wix CMS-collectie "Projecten"
// (Wix-dashboard → CMS → Projecten), dus de volledige inhoud staat direct in de HTML (goed voor
// Google en AI-zoekmachines). Een nieuw of aangepast project is meteen zichtbaar, zonder te publiceren.
// De opmaak komt uit assets/project-render.js; titel, omschrijving en deelafbeelding uit het project zelf.
// Dezelfde code staat ook in src/pages/en/project/[slug].astro (Engelse versie, /en/project/<naam>):
// pas je hier iets aan, kopieer dit bestand dan daarheen (alleen de importpaden verschillen: één ../ meer).
import { fetchWithAuth } from "@wix/sdk/context";
import { oudProject } from "../../../oude-projecten";
import { hero, showcase, about, feats, gallery, contact, more } from "../../../../assets/project-render.js";
import { projectUrl, img, themeStyle, inTaal } from "../../../../assets/projecten.js";

// Taal van deze pagina: /en/project/<naam> is Engels (teksten uit de En-velden in het CMS).
const EN = Astro.url.pathname.startsWith("/en/");
const T = (nl: string, en: string) => (EN ? en : nl);
const PRE = EN ? "/en" : "";

// Oude adressen van yonglo.com (andere naam of niet meer in het portfolio): src/oude-projecten.ts.

const slug = Astro.params.slug || "";
if (!slug) return Astro.redirect(`${PRE}/portfolio`, 301);
const oud = oudProject(slug, EN);
if (oud) return Astro.redirect(oud, 301);

const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const pageUrl =
  forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol)
    ? forwardedUrl
    : Astro.url.href;
const origin = new URL(pageUrl).origin;

// Wix Data, zelfde verzoek als assets/wix/wix-cms.js (queryDataItems), maar met de server-login van Wix.
async function query(dataCollectionId: string, query: any) {
  const res = await fetchWithAuth("https://www.wixapis.com/wix-data/v2/items/query", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ dataCollectionId, query }),
  });
  if (!res.ok) throw new Error(`Wix Data ${dataCollectionId}: ${res.status} ${await res.text()}`);
  const d = await res.json();
  return { items: (d?.dataItems ?? []).map((x: any) => x.data), next: d?.pagingMetadata?.cursors?.next ?? null };
}
async function fetchProjects() {
  const all: any[] = [];
  let page = await query("Projecten", { sort: [{ fieldName: "volgorde", order: "ASC" }, { fieldName: "title", order: "ASC" }], cursorPaging: { limit: 100 } });
  all.push(...page.items);
  while (page.next) {
    page = await query("Projecten", { cursorPaging: { limit: 100, cursor: page.next } });
    all.push(...page.items);
  }
  return all.filter((p) => p.title && p.slug).map((p) => inTaal(p, EN ? "en" : "nl"));
}

let all: any[] = [];
let p: any = null;
let cp: any = null;
let failed = false;
try {
  all = await fetchProjects();
  p = all.find((x) => x.slug === slug) || null;
  if (p?.contactpersoon) {
    cp = (await query("Contactpersonen", { filter: { _id: { $eq: String(p.contactpersoon) } }, cursorPaging: { limit: 1 } }).catch(() => ({ items: [] }))).items[0] || null;
  }
} catch (err) {
  console.error(err);
  failed = true;
}
if (!p) Astro.response.status = failed ? 503 : 404;

// ---- inhoud (zelfde volgorde en nummering als voorheen) -----------------------------------------
let body = "";
if (p) {
  let k = 0;
  const num = () => String(++k).padStart(2, "0");
  const parts = [hero(p), showcase(p)];
  if (about(p, "@")) parts.push(about(p, num()));
  if (feats(p, "@")) parts.push(feats(p, num()));
  if (gallery(p, "@")) parts.push(gallery(p, num()));
  parts.push(contact(p, num(), cp));
  parts.push(more(p, all, num()));
  body = parts.join("\n");
}

// ---- SEO ------------------------------------------------------------------------------------
const trimTo = (s: string, n: number) => {
  s = String(s || "").replace(/\s+/g, " ").trim();
  if (s.length <= n) return s;
  const cut = s.slice(0, n - 1);
  const sp = cut.lastIndexOf(" ");
  return (sp > n * 0.6 ? cut.slice(0, sp) : cut).replace(/[\s,.;:–-]+$/, "") + "…";
};
const url = p ? origin + projectUrl(p) : "";
const title = p ? `${p.title}${p.subkop ? " – " + p.subkop : ""} | Portfolio Yonglo` : failed ? T("Project kon niet worden geladen | Yonglo", "Project could not be loaded | Yonglo") : T("Project niet gevonden | Yonglo", "Project not found | Yonglo");
const desc = p ? trimTo(p.intro || p.kortTekst || T(`Project van Yonglo voor ${p.title}.`, `Project by Yonglo for ${p.title}.`), 158) : "";
const ogImg = p ? img(p.hoofdbeeld || p.portfolioImage || p.heroImage, 1200, 630, "c") : null;
const ORG = { "@type": "Organization", "@id": "https://www.yonglo.com/#organization", name: "Yonglo", url: "https://www.yonglo.com", logo: { "@type": "ImageObject", url: `${origin}/assets/yonglo-logo.png`, width: 512, height: 512 } };
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
const work = p && {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${url}#project`,
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  name: p.title,
  headline: trimTo(`${p.title}${p.subkop ? " – " + p.subkop : ""}`, 110),
  description: desc,
  ...(ogImg ? { image: ogImg } : {}),
  inLanguage: EN ? "en" : "nl-NL",
  creator: ORG,
  ...(p.opdrachtgever || p.title ? { sourceOrganization: { "@type": "Organization", name: p.opdrachtgever || p.title, ...(p.website ? { url: p.website } : {}) } } : {}),
  ...(p.branche ? { genre: p.branche } : {}),
  ...((p.diensten || []).length ? { keywords: (p.diensten || []).join(", ") } : {}),
  ...(p._updatedDate?.$date || p._updatedDate ? { dateModified: p._updatedDate?.$date || p._updatedDate } : {}),
  isPartOf: { "@type": "CollectionPage", "@id": `${origin}${PRE}/portfolio`, name: "Portfolio Yonglo", url: `${origin}${PRE}/portfolio` },
};
const breadcrumb = p && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${origin}${PRE || "/"}` },
    { "@type": "ListItem", position: 2, name: "Portfolio", item: `${origin}${PRE}/portfolio` },
    { "@type": "ListItem", position: 3, name: p.title, item: url },
  ],
};
---
<!doctype html>
<html lang={EN ? "en" : "nl"}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title data-eigen-seo>{title}</title>
{p ? <>
<meta name="description" content={desc} data-eigen-seo>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="canonical" href={url} data-eigen-seo>
<link rel="alternate" hreflang="nl" href={`${origin}/project/${encodeURIComponent(p.slug)}`}>
<link rel="alternate" hreflang="en" href={`${origin}/en/project/${encodeURIComponent(p.slug)}`}>
<link rel="alternate" hreflang="x-default" href={`${origin}/project/${encodeURIComponent(p.slug)}`}>
<meta property="og:site_name" content="Yonglo">
<meta property="og:locale" content={EN ? "en_GB" : "nl_NL"}>
<meta property="og:type" content="website">
<meta property="og:title" content={title.replace(/ \| Portfolio Yonglo$/, "")}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={url}>
{ogImg && <meta property="og:image" content={ogImg}>}
{ogImg && <meta property="og:image:width" content="1200">}
{ogImg && <meta property="og:image:height" content="630">}
<meta name="twitter:card" content={ogImg ? "summary_large_image" : "summary"}>
<script type="application/ld+json" set:html={ld(work)} />
<script type="application/ld+json" set:html={ld(breadcrumb)} />
</> : <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0E0F1A">
<link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="icon" href="/assets/favicon/favicon-192.png" type="image/png" sizes="192x192"><link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png">
<link rel="preconnect" href="https://static.wixstatic.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"></noscript>
<link rel="stylesheet" href="/assets/style.css?v=4">
<link rel="stylesheet" href="/assets/footer.css">
<link rel="stylesheet" href="/assets/page.css">
<link rel="stylesheet" href="/assets/project.css">
<link rel="alternate" type="text/plain" href="/llms.txt" title="Yonglo voor AI-assistenten (llms.txt)">
</head>
<body class="page-sub">
<a class="skip" href="#main">{T("Naar inhoud", "Skip to content")}</a>
<div class="progress" aria-hidden="true"></div>

<header class="hdr" id="top" data-header></header>
<script is:inline src="/assets/header.js"></script>

{p ? (
<main id="main" class="project" style={themeStyle(p)} set:html={body} />
) : (
<main id="main" class="project">
<section class="hero sub-hero pj-hero dark"><div class="blob b1"></div><div class="dots"></div>
  <div class="wrap pj-missing"><nav class="crumbs" aria-label={T("Kruimelpad", "Breadcrumb")}><a href={PRE || "/"}>Home</a><span>/</span><a href={`${PRE}/portfolio`}>Portfolio</a></nav>
  {failed ? <h1>{T("Het project kon niet worden geladen.", "The project could not be loaded.")}</h1> : <h1>{T("Dit project bestaat niet (meer).", "This project does not exist (any more).")}</h1>}
  <p class="lead">{failed ? T("Ververs de pagina of probeer het later nog eens.", "Refresh the page or try again later.") : T("Bekijk al ons werk in het portfolio.", "See all our work in the portfolio.")}</p>
  <a href={`${PRE}/portfolio`} class="btn btn-primary">{T("Naar portfolio", "To portfolio")} <i class="arr">→</i></a></div></section>
</main>
)}

<footer class="fd" data-footer></footer>

<div class="mobbar"><a href="tel:+31852033223">{T("Bel", "Call")}</a><a href="https://wa.me/31638148565" target="_blank" rel="noopener">WhatsApp</a><a href="#contact" class="hl">{T("Kennismaken", "Get in touch")}</a></div>
<a href="https://wa.me/31638148565" class="float-wa" target="_blank" rel="noopener">{T("Vragen? App ons", "Questions? Message us")}</a>
<div class="toast" role="status" aria-live="polite"></div>

<script is:inline src="/assets/app.js?v=4" defer></script>
<script is:inline src="/assets/footer.js" defer></script>
{p && <script is:inline src="/assets/project.js" defer></script>}
{p && <script is:inline src="/assets/project-page.js" defer></script>}
</body>
</html>
