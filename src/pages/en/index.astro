// Engelse homepage (/en): en/index.html, gemaakt door tools/maak-engels.mjs uit index.html.
import { paginaHtml, siteOrigin, htmlResponse, nietGevonden } from "../../paginas";
import { vulHero } from "../../hero-tegels";

export const prerender = false;

// Projectbeelden in de hero al op de server invullen (sneller in beeld), zie src/hero-tegels.ts.
const html = await vulHero(paginaHtml("index", "en", siteOrigin(Astro.request, Astro.url)), "en");
if (!html) return nietGevonden("en");
return htmlResponse(html);
