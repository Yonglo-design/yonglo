---
// De HTML van de help docs (Engels). Gegevens uit src/helpdocs.ts (laadHelpDocs); gebruikt door
// src/pages/help-docs/index.astro, [app].astro en [app]/[slug].astro.
import type { HelpDocsData } from "../helpdocs";
import { appUrl, docUrl, esc } from "../../assets/helpdocs.js";
import config from "../../wix.config.json";

interface Props { d: HelpDocsData }
const { d } = Astro.props;
const { app, doc } = d;
const ok = d.mode !== "leeg";
const ico = (name: string) => esc(String(name).replace(/ for Wix$/, "").split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase());
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title data-eigen-seo>{d.title || "Help docs | Yonglo"}</title>
{ok ? <>
<meta name="description" content={d.desc} data-eigen-seo>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="canonical" href={d.url} data-eigen-seo>
<meta property="og:site_name" content="Yonglo">
<meta property="og:locale" content="en_GB">
<meta property="og:type" content={d.mode === "artikel" ? "article" : "website"}>
<meta property="og:title" content={d.title.replace(/ \| Yonglo$/, "")}>
<meta property="og:description" content={d.desc}>
<meta property="og:url" content={d.url}>
<meta name="twitter:card" content="summary">
{d.jsonld.map((j) => <script type="application/ld+json" set:html={j} />)}
</> : <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0E0F1A">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%22-20%20-8%20118%20118%22%3E%3Crect%20x%3D%22-20%22%20y%3D%22-8%22%20width%3D%22118%22%20height%3D%22118%22%20rx%3D%2228%22%20fill%3D%22%23325FFC%22%2F%3E%3Cpath%20fill%3D%22%23ffffff%22%20d%3D%22M61.4%2C5.1h-13.8c-.8%2C0-1.4.6-1.4%2C1.4v36.6c0%2C5.7-1.5%2C15.4-11.2%2C15.4s-11.3-8.4-11.3-15.4V6.5c0-.8-.6-1.4-1.4-1.4h-13.8c-.8%2C0-1.4.6-1.4%2C1.4v36.6c0%2C15.4%2C7.3%2C26.5%2C19.6%2C30v22.8c0%2C.8.6%2C1.4%2C1.4%2C1.4h13.8c.8%2C0%2C1.4-.6%2C1.4-1.4v-22.8c12.3-3.6%2C19.6-14.6%2C19.6-30V6.5c0-.8-.6-1.4-1.4-1.4Z%22%2F%3E%3C%2Fsvg%3E">
<link rel="preconnect" href="https://static.wixstatic.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"></noscript>
<link rel="stylesheet" href="/assets/style.css?v=4">
<link rel="stylesheet" href="/assets/footer.css">
<link rel="stylesheet" href="/assets/page.css">
<link rel="stylesheet" href="/assets/blog.css">
<link rel="stylesheet" href="/assets/helpdocs.css">
<link rel="alternate" type="text/plain" href="/llms.txt" title="Yonglo for AI assistants (llms.txt)">
<script is:inline id="wix-site-script" src="https://manage.wix.com/_api/headless-business-setup/v1/headless-business/site-script.js" data-client-id={config.appId} async></script>
</head>
<body class="page-sub">
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>

<header class="hdr" id="top" data-header></header>
<script is:inline src="/assets/header.js"></script>

<main id="main" class="hd">

{/* ---------- kop ---------- */}
<section class="post-hero dark no-img hd-hero">
  <div class="post-head">
    <div class="blob b1"></div><div class="dots"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/en">Home</a><span>/</span>
        {d.mode === "overzicht" ? <b>Help docs</b> : <a href="/help-docs">Help docs</a>}
        {app && <><span>/</span>{d.mode === "app" ? <b>{app.app}</b> : <a href={appUrl(app.app)}>{app.app}</a>}</>}
        {doc && <><span>/</span><b>{doc.title.length > 48 ? doc.title.slice(0, 47) + "…" : doc.title}</b></>}
      </nav>
      {d.mode === "overzicht" && <>
        <p class="eyebrow">Wix apps by Yonglo</p>
        <h1>Help <em>docs</em>.</h1>
        <p class="lead">Guides, setup instructions and answers to common questions for our apps in the Wix App Market.</p>
      </>}
      {d.mode === "app" && <>
        <p class="eyebrow">Help docs</p>
        <h1>{app.app}</h1>
        {app.info.intro && <p class="lead">{app.info.intro}</p>}
        {app.info.market && <p class="hd-cta"><a class="btn btn-primary" href={app.info.market} target="_blank" rel="noopener">Get the app in the Wix App Market <i class="arr">↗</i></a></p>}
      </>}
      {d.mode === "artikel" && <>
        <p class="eyebrow">{app.app}</p>
        <h1>{doc.title}</h1>
        {d.lead && <p class="lead">{d.lead}</p>}
      </>}
      {d.mode === "leeg" && <>
        <h1>{d.failed ? "The help docs could not be loaded." : <>This page does <em>not exist</em>.</>}</h1>
        <p class="lead">{d.failed ? "Refresh the page or try again later." : "It may have moved. Find your article in the help docs."}</p>
        <p class="post-nf"><a class="btn btn-primary" href={app ? appUrl(app.app) : "/help-docs"}>To the help docs <i class="arr">→</i></a></p>
      </>}
    </div>
  </div>
</section>

{/* ---------- alle apps ---------- */}
{d.mode === "overzicht" && (
<section class="light hd-main">
  <div class="wrap">
    <div class="hd-apps">
      {d.apps.map((a) => (
        <article class="hd-app">
          <div class="hd-app-head"><span class="hd-ico" aria-hidden="true" set:html={ico(a.app)} /><div><h2><a href={appUrl(a.app)}>{a.app}</a></h2><small>{a.docs.length} {a.docs.length === 1 ? "article" : "articles"}</small></div></div>
          {a.info.intro && <p>{a.info.intro}</p>}
          <ul class="hd-list">{a.docs.slice(0, 6).map((x: any) => <li><a href={docUrl(x)}>{x.title}</a></li>)}</ul>
          <div class="hd-app-foot">
            <a class="btn btn-dark" href={appUrl(a.app)}>All {a.app} docs <i class="arr">→</i></a>
            {a.info.market && <a class="hd-ext" href={a.info.market} target="_blank" rel="noopener">Wix App Market ↗</a>}
          </div>
        </article>
      ))}
    </div>
    {!d.apps.length && <p class="hd-empty">There are no help articles yet.</p>}
  </div>
</section>
)}

{/* ---------- één app ---------- */}
{d.mode === "app" && (
<section class="light hd-main">
  <div class="wrap">
    <ol class="hd-index">
      {app.docs.map((x: any) => (
        <li class={x.depth ? "sub" : "top"}>
          <a href={docUrl(x)}><b>{x.title}</b>{x.omschrijving && <span>{x.omschrijving}</span>}<i class="arr" aria-hidden="true">→</i></a>
        </li>
      ))}
    </ol>
  </div>
</section>
)}

{/* ---------- artikel ---------- */}
{d.mode === "artikel" && (
<section class="light hd-main">
  <div class="wrap hd-layout">
    <aside class="hd-side">
      <details class="hd-nav" open>
        <summary>{app.app}</summary>
        <nav aria-label={`${app.app} articles`}>
          <ul>{app.docs.map((x: any) => <li class={x.depth ? "sub" : ""}><a href={docUrl(x)} aria-current={x._id === doc._id ? "page" : undefined}>{x.title}</a></li>)}</ul>
        </nav>
      </details>
      {d.apps.length > 1 && <p class="hd-other">Other apps: {d.apps.filter((a) => a.app !== app.app).map((a, i) => <>{i > 0 && ", "}<a href={appUrl(a.app)}>{a.app}</a></>)}</p>}
    </aside>
    <script is:inline>if (matchMedia("(max-width:991px)").matches) document.querySelector(".hd-nav")?.removeAttribute("open");</script>
    <article class="hd-article">
      {d.toc.length > 0 && (
        <nav class="post-toc" aria-labelledby="toc-t"><p class="eyebrow" id="toc-t">On this page</p><ol>{d.toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol></nav>
      )}
      <div class="post-body" set:html={d.html} />
      {d.faqs.length > 0 && (
        <div class="hd-faq" role="region" aria-labelledby="faq-t">
          <h2 id="faq-t">Frequently asked questions</h2>
          {d.faqs.map((f) => <details><summary>{f.q}</summary><div class="hd-faq-a" set:html={f.a} /></details>)}
        </div>
      )}
      <nav class="hd-pager" aria-label="More articles">
        {d.prev ? <a class="prev" href={docUrl(d.prev)}><small>← Previous</small><b>{d.prev.title}</b></a> : <span></span>}
        {d.next ? <a class="next" href={docUrl(d.next)}><small>Next →</small><b>{d.next.title}</b></a> : <span></span>}
      </nav>
      <div class="hd-help">
        <div><b>Still need help?</b><span>Our support team is happy to help you with {app.app}.</span></div>
        <div class="hd-help-btns">
          <a class="btn btn-primary" href={`mailto:contact@yonglo.com?subject=${encodeURIComponent("Support: " + app.app)}`}>Email support <i class="arr">→</i></a>
          <a class="btn btn-ghost" href="https://wa.me/31638148565" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </article>
  </div>
</section>
)}

</main>

<footer class="fd" data-footer></footer>

<div class="mobbar"><a href="mailto:contact@yonglo.com">Email</a><a href="https://wa.me/31638148565" target="_blank" rel="noopener">WhatsApp</a><a href="/help-docs" class="hl">Help docs</a></div>
<div class="toast" role="status" aria-live="polite"></div>

<script is:inline src="/assets/app.js?v=4" defer></script>
<script is:inline src="/assets/footer.js" defer></script>
</body>
</html>
